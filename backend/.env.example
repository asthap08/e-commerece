APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://app:CHANGE_ME@localhost:5432/commerce?sslmode=disable
# Comma-separated browser origins allowed to call the API (storefront + admin)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
CHECKOUT_ENABLED=true
# Card payments (leave empty to run cash-on-delivery only)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set true ONLY when the API runs behind a reverse proxy you control (trusts X-Forwarded-For)
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_PER_MINUTE=20
# Public storefront URL used in e-mail links (defaults to the first CORS origin)
PUBLIC_URL=http://localhost:3000
# Transactional e-mail (password reset, order confirmation). Empty SMTP_HOST = log only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="OmniRetail <no-reply@example.com>"
# REDIS_URL is no longer required (it was never used)
